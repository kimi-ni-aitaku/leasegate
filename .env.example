# Local compose starts without an .env; crypto keys are generated in the runtime volume.
# Copy this file to .env for deployment settings. Never commit .env.
ENVIRONMENT=development
DEMO_ENABLED=true
PUBLIC_ORIGIN=http://localhost
CORS_ORIGINS=http://localhost
COOKIE_SECURE=false
BIND_ADDRESS=127.0.0.1
PORT=80
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# For running Python outside Docker, generate the four keys with scripts/init_env.py.
# SIGNING_KEY=
# ENCRYPTION_KEY=base64-url-safe-32-byte-key
# WEBHOOK_SECRET=
# ADMIN_TOKEN=
# DATABASE_URL=postgresql+psycopg://leasegate:password@localhost:5432/leasegate
# REDIS_URL=redis://localhost:6379/0
# Production: ENVIRONMENT=production, DEMO_ENABLED=false, COOKIE_SECURE=true, HTTPS origin.
DELIVERY_URL=
DELIVERY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional, explicitly authorized official RFC 8628 provider. HTTPS issuer origin must match endpoints.
OAUTH_ISSUER=
OAUTH_DEVICE_ENDPOINT=
OAUTH_TOKEN_ENDPOINT=
OAUTH_REVOCATION_ENDPOINT=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPE=
# Local Python only; Compose uses a dedicated private cookie-data volume.
# QUARK_COOKIE_FILE=.private/quark-cookie.enc
# Enable only when the owner explicitly chooses phone confirmation.
QUARK_MANUAL_CONFIRMATION_ENABLED=false
# Operator-owned, authenticated authorization gateway; see VIP-PRODUCT.md.
# No external gateway or native signer is bundled or enabled by default.
VIP_GATEWAY_URL=
VIP_GATEWAY_SECRET=
VIP_NOTICE=仅支持在电脑端登录。请保持电脑上的登录二维码窗口打开。
